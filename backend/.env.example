# Compass connects to the same database server. It is not a database server itself.
MONGODB_URI=mongodb://127.0.0.1:27017/?retryWrites=false
MONGODB_DB=auto_safety_report
PORT=3001
SUPERADMIN1_PASSWORD=superadmin1
SUPERADMIN2_PASSWORD=superadmin2
ADMIN1_PASSWORD=admin1
ADMIN2_PASSWORD=admin2
# Match your frontend URL (comma-separated if necessary).
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# After initializing the map, link the sender on the Super Admin QR page. No API key.
WHATSAPP_ENABLED=true
WHATSAPP_DEFAULT_COUNTRY_CODE=852
# Optional: set if the bundled Puppeteer browser cannot launch.
# WHATSAPP_CHROME_PATH=/Applications/Google Chrome.app/Contents/MacOS/Google Chrome
